# Copy to key.properties and fill in your keystore details
# Generate keystore with:
#   keytool -genkey -v -keystore hoppity-release.jks \
#     -alias hoppity -keyalg RSA -keysize 2048 -validity 10000
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=hoppity
storeFile=../hoppity-release.jks
